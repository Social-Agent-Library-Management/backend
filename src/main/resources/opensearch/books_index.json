{
  "settings": {
    "analysis": {
      "char_filter": {
        "hangul_jamo": {
          "type": "icu_normalizer",
          "name": "nfc",
          "mode": "decompose"
        }
      },
      "tokenizer": {
        "char_unigram": {
          "type": "ngram",
          "min_gram": 1,
          "max_gram": 1,
          "token_chars": [
            "letter",
            "digit"
          ]
        }
      },
      "filter": {
        "title_shingle": {
          "type": "shingle",
          "min_shingle_size": 2,
          "max_shingle_size": 3
        },
        "jamo_glue": {
          "type": "shingle",
          "min_shingle_size": 2,
          "max_shingle_size": 2,
          "token_separator": "",
          "output_unigrams": true
        }
      },
      "analyzer": {
        "char_substring": {
          "type": "custom",
          "tokenizer": "char_unigram",
          "filter": [
            "lowercase"
          ]
        },
        "jamo_word": {
          "type": "custom",
          "char_filter": [
            "hangul_jamo"
          ],
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "jamo_glue"
          ]
        },
        "jamo_trigram": {
          "type": "custom",
          "char_filter": [
            "hangul_jamo"
          ],
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "title_shingle"
          ]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "bookId": {
        "type": "long"
      },
      "title": {
        "type": "text",
        "index": false,
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "char_substring"
          },
          "jamo": {
            "type": "text",
            "analyzer": "jamo_word"
          },
          "jamotri": {
            "type": "text",
            "analyzer": "jamo_trigram"
          }
        }
      },
      "author": {
        "type": "text",
        "index": false,
        "fields": {
          "ngram": {
            "type": "text",
            "analyzer": "char_substring"
          }
        }
      },
      "publisher": {
        "type": "keyword",
        "index": false
      },
      "isbn": {
        "type": "keyword",
        "index": false
      },
      "createdAt": {
        "type": "date"
      }
    }
  }
}
